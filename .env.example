# Настройки проекта. Скопируйте файл: copy .env.example .env
# Файл .env содержит пароли и не добавляется в Git.

HTTP_PORT=8081
ADMINER_PORT=8082

POSTGRES_USER=coursehub
POSTGRES_PASSWORD=coursehub-password
POSTGRES_DB=coursehub

# Интервал резервного копирования в секундах (300 = 5 минут)
BACKUP_INTERVAL=300
